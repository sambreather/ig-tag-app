# Copy this file to .env for local testing, or set these as Environment
# Variables in Railway's dashboard for the live app. Never commit a real
# .env file to GitHub.

# --- App ---
PORT=3000

# Login credentials. Two roles: a shared team login for colleagues, and an
# admin login (you) which additionally unlocks client add/edit/delete and
# the General Settings screen.
TEAM_USERNAME=
TEAM_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Where the data file lives. On Railway, set this to a mounted Volume path
# (e.g. /data) so data survives redeploys.
DATA_DIR=

# --- Backblaze B2 (S3-compatible) storage ---
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com

# --- Meta / Instagram ---
META_APP_ID=
META_APP_SECRET=

# Any random string you invent. You type the SAME value into Meta's webhook
# setup screen; Meta echoes it back once to prove the endpoint is yours.
META_WEBHOOK_VERIFY_TOKEN=
# Long-lived access token generated per connected Instagram account.
# In the real app these live in the database (one per client), not here -
# this single value is only for early local testing against one account.
IG_TEST_ACCESS_TOKEN=
